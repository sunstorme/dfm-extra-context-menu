#!/bin/sh
set -e

# DDE-Tools config script
# 在安装前询问用户是否重启托盘应用

. /usr/share/debconf/confmodule

# 仅在升级时询问（新安装没有运行中的实例）
if [ "$1" = "configure" ] && [ -n "$2" ]; then
    # 检测是否有运行中的 dfm-tools 托盘
    if pgrep -f "dfm-tools --tray" > /dev/null 2>&1; then
        db_input high dfm-tools/restart-tray || true
    fi
fi

db_go || true
